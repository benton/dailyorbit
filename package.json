{
  "name": "daily-orbit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm-run-all2 --parallel build:web build:server",
    "build:server": "pnpm --filter @daily-orbit/server build",
    "build:web": "pnpm --filter @daily-orbit/web build",
    "dev": "npm-run-all2 --parallel dev:web dev:server",
    "dev:server": "pnpm --filter @daily-orbit/server dev",
    "dev:setup": "npm-run-all2 --parallel dev:setup:web dev:setup:server",
    "dev:setup:server": "pnpm --filter @daily-orbit/server dev:setup",
    "dev:setup:web": "pnpm --filter @daily-orbit/web dev:setup",
    "dev:web": "pnpm --filter @daily-orbit/web dev",
    "test": "npm-run-all2 --parallel test:web test:server",
    "test:server": "pnpm --filter @daily-orbit/server test",
    "test:web": "pnpm --filter @daily-orbit/web test"
  },
  "devDependencies": {
    "npm-run-all2": "^8.0.4"
  },
  "engines": {
    "node": ">=23.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "version": "1.30.1"
}
