{
  "name": "@daily-orbit/server",
  "version": "1.0.0",
  "bin": {
    "daily-orbit": "./dist/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "nodemon --exec 'node --no-warnings src/index.ts' --ext ts",
    "dev:setup": "mkdir -pv data",
    "format": "oxfmt",
    "lint": "oxlint .",
    "lint:format": "oxfmt",
    "test": "npm-run-all2 --parallel tsc:check vitest:run lint lint:format",
    "tsc:check": "tsgo",
    "vitest:run": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1009.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1009.0",
    "@duckdb/node-api": "1.5.0-r.1",
    "@hono/node-server": "^1.14.3",
    "better-auth": "^1.4.18",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "hono": "^4.7.11",
    "mustache": "^4.2.0",
    "node-html-parser": "^7.1.0",
    "pdf-oxide-wasm": "^0.3.17"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260212.1",
    "nodemon": "^3.1.10",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=23.0.0",
    "pnpm": ">=10.0.0"
  }
}
