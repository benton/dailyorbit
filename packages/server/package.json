{
  "name": "@daily-orbit/server",
  "version": "1.30.0",
  "bin": {
    "daily-orbit": "./dist/bin.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "echo 'Use: ./daily-orbit serve api --watch' && exit 1",
    "dev:setup": "mkdir -pv ../../data",
    "format": "oxfmt",
    "lint": "oxlint .",
    "lint:format": "oxfmt",
    "test": "npm-run-all2 --parallel tsc:check vitest:run lint lint:format",
    "tsc:check": "tsgo",
    "vitest:run": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1009.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1009.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1018.0",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/client-sesv2": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.1014.0",
    "@duckdb/node-api": "1.5.0-r.1",
    "@extractus/article-extractor": "^8.0.20",
    "@hono/node-server": "^1.14.3",
    "better-auth": "^1.4.18",
    "citty": "^0.2.1",
    "file-type": "^22.0.0",
    "hono": "^4.7.11",
    "mustache": "^4.2.0",
    "node-html-parser": "^7.1.0",
    "nodemailer": "^8.0.3",
    "opendal": "^0.49.2",
    "pdf-oxide-wasm": "^0.3.17",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.11",
    "@typescript/native-preview": "7.0.0-dev.20260212.1",
    "nodemon": "^3.1.10",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "tsdown": "^0.12.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=23.0.0",
    "pnpm": ">=10.0.0"
  }
}
