{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BedrockInvoke",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/*",
        "arn:aws:bedrock:*:665226324657:*"
      ]
    },
    {
      "Sid": "SesSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "arn:aws:ses:us-east-2:665226324657:identity/dailyorbit.org"
    },
    {
      "Sid": "StorageBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::daily-orbit-storage"
    },
    {
      "Sid": "StorageBucketRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::daily-orbit-storage/*"
    },
    {
      "Sid": "StorageBucketWrite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::daily-orbit-storage/db/*",
        "arn:aws:s3:::daily-orbit-storage/attachments/*",
        "arn:aws:s3:::daily-orbit-storage/parquet/*"
      ]
    },
    {
      "Sid": "SnapshotRetentionPrune",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::daily-orbit-storage/db/*"
    },
    {
      "Sid": "NewspaperImageMigrationRead",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::daily-orbit-prod-frontend",
        "arn:aws:s3:::daily-orbit-prod-frontend/*"
      ]
    }
  ]
}
